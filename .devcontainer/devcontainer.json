{
  "name": "codeo",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
  "runArgs": ["--name=${localWorkspaceFolderBasename}-${devcontainerId}", "--memory=4g", "--cpus=2"],
  "mounts": [
    "source=codeo-gh,target=/home/dev/.config/gh,type=volume",
    "source=codeo-git,target=/home/dev/.config/git,type=volume"
  ],
  "containerEnv": {
    "GIT_CONFIG_GLOBAL": "/home/dev/.config/git/config"
  },
  "postCreateCommand": "bash .devcontainer/scripts/devcontainer-start.sh",
  "postStartCommand": "bash .devcontainer/scripts/window-title.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "timonwong.shellcheck",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "[markdown]": {
          "files.trimTrailingWhitespace": false
        }
      }
    }
  }
}
