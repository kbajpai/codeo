#!/usr/bin/env bash
# codeo: the host command for working an issue in a dev container or a Docker Sandboxes (sbx)
# sandbox. It wraps codeo-container.sh and codeo-sandbox.sh, which live in $CODEO_HOME (default
# ~/codeo). Needs bash 4.3 or later on Linux; docker and sbx are each optional.
#
#   codeo help
#
# Every command checks its arguments first: a bad or missing argument, or an unknown command, prints
# a usage on stderr, exits 2 and runs nothing. Add a command by writing a cmd_<name> function and
# listing its name in the case in main.
set -euo pipefail

# die <message> [code]: print "codeo: <message>" on stderr and exit with code (default 1).
die() {
    echo "codeo: $1" >&2
    exit "${2:-1}"
}

# usage: print the command list on stderr and exit 2.
usage() {
    cat >&2 <<'USAGE'
usage: codeo <command> [args]
  home [--rebuild]                                    start the home dev container
  issue <N> [<branch>] [--rebuild] [--container|--sandbox]  start work on issue N
  shell home|<N>                                      open a shell in the home or issue environment
  open <N>                                            open the issue's sandbox in VS Code
  list                                                list issue containers and sandboxes
  rm <N> [--force]                                    remove the issue's container or sandbox
  default [container|sandbox]                         show or set the default kind for issue
  update                                              update codeo and its scripts
  help                                                show this help
USAGE
    exit 2
}

# valid_number <N>: a positive integer without a leading zero.
valid_number() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

# valid_branch <branch>: starts with a letter or digit, holds only A-Za-z0-9._/- and has no "..".
valid_branch() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ && "$1" != *..* ]]
}

# home_dir: print the directory holding the scripts and sandbox clones.
home_dir() {
    printf '%s\n' "${CODEO_HOME:-$HOME/codeo}"
}

# cmd_help: print the commands on stdout, and the PATH line when ~/.local/bin is not on PATH.
cmd_help() {
    [[ $# -eq 0 ]] || usage
    cat <<'HELP'
codeo: work a GitHub issue in a dev container or an sbx sandbox.

  codeo home [--rebuild]                                    start the home dev container
  codeo issue <N> [<branch>] [--rebuild] [--container|--sandbox]  start work on issue N
  codeo shell home|<N>                                      open a shell in the home or issue environment
  codeo open <N>                                            open the issue's sandbox in VS Code
  codeo list                                                list issue containers and sandboxes
  codeo rm <N> [--force]                                    remove the issue's container or sandbox
  codeo default [container|sandbox]                         show or set the default kind for issue
  codeo update                                              update codeo and its scripts
  codeo help                                                show this help
HELP
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *)
            echo
            echo '~/.local/bin is not on your PATH; add this line to your shell profile:'
            echo 'export PATH="$HOME/.local/bin:$PATH"'
            ;;
    esac
}

# ensure_home: create the home directory and download any missing script into it.
ensure_home() {
    local dir base f name
    dir=$(home_dir)
    base=${CODEO_RAW_URL:-https://raw.githubusercontent.com/kbajpai/codeo/main}
    mkdir -p "$dir"
    for f in .devcontainer/codeo-container.sh .sbx/codeo-sandbox.sh; do
        name=${f##*/}
        [[ -s "$dir/$name" ]] && continue
        if ! curl -fsSL -o "$dir/$name.part" "$base/$f"; then
            rm -f "$dir/$name.part"
            die "could not download $base/$f"
        fi
        mv "$dir/$name.part" "$dir/$name"
    done
}

# find_branch <N>: print the one origin branch holding .codeo/<N>/init.md, else die naming what was
# found. Uses a blob-less bare clone in the home directory, fetched on every lookup.
find_branch() {
    local n=$1 dir repo_url b
    local -a found=()
    dir=$(home_dir)
    repo_url=${CODEO_REPO_URL:-https://github.com/kbajpai/codeo.git}
    if [[ ! -d "$dir/.lookup.git" ]]; then
        git clone --bare --filter=blob:none "$repo_url" "$dir/.lookup.git" >&2 ||
            die "could not clone $repo_url"
    fi
    git -C "$dir/.lookup.git" fetch --prune origin '+refs/heads/*:refs/heads/*' >&2 ||
        die "could not fetch $repo_url"
    while IFS= read -r b; do
        [[ -n "$b" ]] || continue
        if git -C "$dir/.lookup.git" cat-file -e "$b:.codeo/$n/init.md" 2>/dev/null; then
            found+=("$b")
        fi
    done < <(git -C "$dir/.lookup.git" for-each-ref --format='%(refname:short)' refs/heads)
    case ${#found[@]} in
        1) printf '%s\n' "${found[0]}" ;;
        0) die "no branch holds .codeo/$n/init.md; pass the branch: codeo issue $n <branch>" ;;
        *) die "several branches hold .codeo/$n/init.md (${found[*]}); pass one: codeo issue $n <branch>" ;;
    esac
}

# run_script <script> <args...>: run a script from the home directory; its exit status is ours.
run_script() {
    local script
    script="$(home_dir)/$1"
    shift
    cd "$(home_dir)"
    exec bash "$script" "$@"
}

# cmd_home [--rebuild]: start the home dev container.
cmd_home() {
    local a
    for a in "$@"; do
        [[ "$a" == --rebuild ]] || usage
    done
    ensure_home
    run_script codeo-container.sh home "$@"
}

# cmd_issue <N> [<branch>] [--rebuild] [--container]: start work on issue N in a dev container.
cmd_issue() {
    [[ $# -ge 1 ]] || usage
    local n=$1 branch="" rebuild="" a
    shift
    valid_number "$n" || usage
    for a in "$@"; do
        case "$a" in
            --rebuild) rebuild=--rebuild ;;
            --container) ;;
            *)
                [[ -z "$branch" ]] || usage
                valid_branch "$a" || usage
                branch=$a
                ;;
        esac
    done
    ensure_home
    [[ -n "$branch" ]] || branch=$(find_branch "$n")
    run_script codeo-container.sh issue "$n" "$branch" ${rebuild:+"$rebuild"}
}

# cmd_shell home|<N>: open a shell in the home or issue dev container.
cmd_shell() {
    [[ $# -eq 1 ]] || usage
    if [[ "$1" != home ]]; then
        valid_number "$1" || usage
    fi
    ensure_home
    run_script codeo-container.sh shell "$1"
}

main() {
    [[ $# -gt 0 ]] || usage
    local cmd=$1
    shift
    case "$cmd" in
        home) cmd_home "$@" ;;
        issue) cmd_issue "$@" ;;
        shell) cmd_shell "$@" ;;
        help | -h | --help) cmd_help "$@" ;;
        *) usage ;;
    esac
}

main "$@"
