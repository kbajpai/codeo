{
  "enabledPlugins": {
    "codeo@codeo": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR}/.devcontainer/scripts/session-title.sh\"; [ -f \"$f\" ] && bash \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR}/.devcontainer/scripts/session-title.sh\"; [ -f \"$f\" ] && bash \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
